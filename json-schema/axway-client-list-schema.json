{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/axway/main/json-schema/axway-client-list-schema.json",
  "title": "ClientList",
  "description": "A list of Client objects.",
