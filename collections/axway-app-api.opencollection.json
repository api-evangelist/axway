                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of applications for the signed-in user\n\n___Auth Requirement___\n - Access to the organization.\n"
        },
        {
          "info": {
            "name": "Axway Create App",
            "type": "http"
