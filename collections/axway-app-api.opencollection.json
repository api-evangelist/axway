            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.axway.com/api/v1/app",
            "params": [
              {
                "name": "fields",
                "value": "example_value",
                "type": "query",
                "description": "A list of fields to include in the response."
              },
              {
                "name": "exclude_fields",
                "value": "",
                "type": "query",
                "description": "A list of fields to exclude from the response."
              },
              {
                "name": "add_fields",
                "value": "",
