            "name": "Axway Uploads an Automatic Usage Report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.axway.com/api/v1/usage/automatic",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "organizationId",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "uploadMethod",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "userId",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "key": "connect.sid",
              "value": "{{connect.sid}}",
              "placement": "query"
            }
          },
          "docs": "Uploads an automatic usage report for org\n\n___Auth Requirement___\n - _One of_\n     - Support access.\n     - `administrator`, `api_central_admin`, or `usage_reporter` access to the organization.\n"
        },
