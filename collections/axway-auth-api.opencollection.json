            "auth": {
              "type": "apikey",
              "key": "connect.sid",
              "value": "{{connect.sid}}",
              "placement": "query"
            }
          },
          "docs": "Marks acceptance of Terms & Conditions.\n\n___Auth Requirement___\n - Signed-in user.\n\n\n_Allows consumer organization access_\n"
