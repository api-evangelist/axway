        {
          "info": {
            "name": "Axway Validates a User Password",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.axway.com/api/v1/auth/validatePassword",
            "headers": [
              {
                "name": "x-auth-password",
                "value": "********"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-auth-password",
              "value": "{{x-auth-password}}",
              "placement": "header"
            }
          },
          "docs": "Validates the supplied password is valid for the signed-in user.\n\n___Auth Requirement___\n - User password.\n\n\n_Allows consumer organization access_\n"
        },
